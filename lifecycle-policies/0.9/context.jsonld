{
  "@context": {
    "@version": 1.1,
    "dcterms": "http://purl.org/dc/terms/",
    "lp": "https://jamie-clayton.github.io/githerd-rules/lifecycle-policies/0.9/terms#",

    "$schema": { "@id": "dcterms:conformsTo", "@type": "@id" },
    "title": "dcterms:title",
    "description": "dcterms:description",
    "identifier": "dcterms:identifier",
    "creator": "dcterms:creator",
    "contributor": { "@id": "dcterms:contributor", "@container": "@set" },
    "publisher": "dcterms:publisher",
    "subject": { "@id": "dcterms:subject", "@container": "@set" },
    "created": "dcterms:created",
    "modified": "dcterms:modified",
    "version": "dcterms:hasVersion",
    "source": "dcterms:source",
    "language": "dcterms:language",
    "coverage": "dcterms:coverage",
    "rights": "dcterms:rights",
    "references": { "@id": "dcterms:references", "@container": "@set" },
    "rolesRef": "dcterms:requires",

    "fieldContract": "lp:fieldContract",
    "rule": "lp:rule",
    "rationale": "lp:rationale",
    "appliesTo": "lp:appliesTo",

    "vocabulary": "lp:vocabulary",
    "roles": { "@id": "lp:role", "@container": "@set" },
    "triggeredBy": { "@id": "lp:triggeredBy", "@container": "@set" },
    "active": { "@id": "lp:active", "@container": "@set" },
    "retired": { "@id": "lp:retired", "@container": "@set" },
    "value": "lp:value",
    "replacedBy": "dcterms:isReplacedBy",
    "deprecatedAt": "lp:deprecatedAt",
    "removedAt": "lp:removedAt",
    "deprecationWindow": "lp:deprecationWindow",
    "unit": "lp:unit",
    "length": "lp:length",

    "policies": { "@id": "lp:policy", "@container": "@index" },
    "type": "dcterms:type",
    "field": "lp:field",
    "validStatuses": { "@id": "lp:validStatus", "@container": "@set" },
    "transitions": { "@id": "lp:transition", "@container": "@set" },
    "from": "lp:from",
    "to": "lp:to",
    "approverRoles": { "@id": "lp:approverRole", "@container": "@set" },
    "notes": "dcterms:description"
  }
}
