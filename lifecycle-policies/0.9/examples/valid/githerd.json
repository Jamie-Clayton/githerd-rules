{
  "$schema": "https://jamie-clayton.github.io/githerd-rules/lifecycle-policies/0.9/lifecycle-policies.schema.json",
  "title": "Githerd lifecycle policies",
  "identifier": "ark:/99999/example-githerd",
  "created": "2026-07-06T11:00:00+10:00",
  "modified": "2026-07-06T11:00:00+10:00",
  "version": "2.0.0",
  "description": "Per-type document lifecycle policies for Githerd. Authoritative vocabulary for the front-matter `lifecycle:` key. Seeded per ADR-037 from the Gelato-autopilot precedent, corrected to Githerd's observed states (D2). Consumers fall back to hard-coded defaults with a logged warning if this file is absent or invalid (D3).",
  "publisher": "Jamie-Clayton/githerd",
  "language": "en-AU",
  "rights": "Apache-2.0",
  "rolesRef": "docs/registers/roles.json",
  "vocabulary": {
    "roles": [
      "architect",
      "deliveryPlanning",
      "productOwner",
      "technicalLead"
    ],
    "triggeredBy": {
      "active": [
        "checkpoint",
        "decision",
        "milestone"
      ],
      "retired": [
        {
          "value": "gate",
          "replacedBy": "checkpoint",
          "deprecatedAt": "2026-07-06"
        }
      ]
    },
    "deprecationWindow": {
      "unit": "release",
      "length": 1
    }
  },
  "policies": {
    "initiative": {
      "type": "initiative",
      "field": "lifecycle",
      "validStatuses": [
        "draft",
        "approved",
        "archived",
        "superseded"
      ],
      "transitions": [
        {
          "from": "draft",
          "to": "approved",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "draft",
          "to": "archived",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "draft",
          "to": "superseded",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "approved",
          "to": "archived",
          "triggeredBy": [
            "decision",
            "milestone"
          ]
        },
        {
          "from": "approved",
          "to": "superseded",
          "triggeredBy": [
            "decision"
          ]
        }
      ],
      "approverRoles": [
        "architect",
        "productOwner",
        "deliveryPlanning"
      ],
      "notes": "No 'delivering' state: initiatives stay 'approved' through delivery; only plan status moves while work is in flight. draft -> archived is legal for retroactive closure of shipped work with no recorded approval (init-005 precedent). Archival is gated by a UAT artifact or a documented exemption rationale."
    },
    "adr": {
      "type": "adr",
      "field": "lifecycle",
      "validStatuses": [
        "proposed",
        "review",
        "approved",
        "superseded"
      ],
      "transitions": [
        {
          "from": "proposed",
          "to": "review",
          "triggeredBy": [
            "decision",
            "checkpoint"
          ]
        },
        {
          "from": "proposed",
          "to": "approved",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "review",
          "to": "approved",
          "triggeredBy": [
            "decision",
            "checkpoint"
          ]
        },
        {
          "from": "approved",
          "to": "superseded",
          "triggeredBy": [
            "decision"
          ]
        }
      ],
      "approverRoles": [
        "architect",
        "productOwner",
        "technicalLead"
      ],
      "notes": "Githerd ADRs begin at 'proposed' (not the Gelato 'draft'). proposed -> approved without a review stop is legal for post-hoc ratification of decisions already realised in shipped code (ADR-012, ADR-037 precedents). Approved ADRs are never archived; a dead decision is 'superseded' by its successor."
    },
    "design": {
      "type": "design",
      "field": "lifecycle",
      "validStatuses": [
        "draft",
        "review",
        "approved",
        "delivered",
        "superseded"
      ],
      "transitions": [
        {
          "from": "draft",
          "to": "review",
          "triggeredBy": [
            "decision",
            "checkpoint"
          ]
        },
        {
          "from": "draft",
          "to": "delivered",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "review",
          "to": "approved",
          "triggeredBy": [
            "decision",
            "checkpoint"
          ]
        },
        {
          "from": "approved",
          "to": "delivered",
          "triggeredBy": [
            "milestone",
            "checkpoint"
          ]
        },
        {
          "from": "draft",
          "to": "superseded",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "review",
          "to": "superseded",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "approved",
          "to": "superseded",
          "triggeredBy": [
            "decision"
          ]
        }
      ],
      "approverRoles": [
        "architect",
        "technicalLead"
      ],
      "notes": "draft -> delivered is legal for specs whose implementation shipped without a formal review stop (G10 sweep precedent, PR #94 / #120). 'superseded' entries must link their successor document."
    },
    "spec": {
      "type": "spec",
      "field": "lifecycle",
      "validStatuses": [
        "draft",
        "review",
        "approved",
        "delivered",
        "superseded"
      ],
      "transitions": [
        {
          "from": "draft",
          "to": "review",
          "triggeredBy": [
            "decision",
            "checkpoint"
          ]
        },
        {
          "from": "draft",
          "to": "delivered",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "review",
          "to": "approved",
          "triggeredBy": [
            "decision",
            "checkpoint"
          ]
        },
        {
          "from": "approved",
          "to": "delivered",
          "triggeredBy": [
            "milestone",
            "checkpoint"
          ]
        },
        {
          "from": "draft",
          "to": "superseded",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "review",
          "to": "superseded",
          "triggeredBy": [
            "decision"
          ]
        },
        {
          "from": "approved",
          "to": "superseded",
          "triggeredBy": [
            "decision"
          ]
        }
      ],
      "approverRoles": [
        "architect",
        "technicalLead"
      ],
      "notes": "Same policy as 'design'; kept as a separate entry so matching on the front-matter `type:` value is direct (briefing requirement). New spec-shaped documents should prefer type: design per the design-doc id convention."
    }
  }
}
