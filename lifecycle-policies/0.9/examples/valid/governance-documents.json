{
  "$schema": "https://jamie-clayton.github.io/githerd-rules/lifecycle-policies/0.9/lifecycle-policies.schema.json",
  "title": "Engineering governance documents",
  "description": "Lifecycles for documents that record decisions and intent: initiatives, decision records and designs. Long-lived, approved by a small group of senior roles, and never deleted once approved; a dead decision is superseded by its successor.",
  "identifier": "https://example.org/policies/governance-documents",
  "publisher": "example-org/engineering-handbook",
  "created": "2026-07-06T11:00:00+10:00",
  "modified": "2026-10-06T09:00:00+10:00",
  "version": "2.0.0",
  "language": "en-AU",
  "coverage": "example-org/engineering-handbook docs/**",
  "rights": "Apache-2.0",
  "rolesRef": "docs/registers/roles.json",
  "vocabulary": {
    "roles": ["architect", "productOwner", "technicalLead", "deliveryLead"],
    "triggeredBy": {
      "active": ["decision", "checkpoint", "milestone"],
      "retired": [
        { "value": "gate", "replacedBy": "checkpoint", "deprecatedAt": "2026-05-10", "removedAt": "2026-08-15" }
      ]
    },
    "deprecationWindow": { "unit": "release", "length": 1 }
  },
  "policies": {
    "initiative": {
      "type": "initiative",
      "field": "lifecycle",
      "validStatuses": ["draft", "approved", "archived", "superseded"],
      "transitions": [
        { "from": "draft", "to": "approved", "triggeredBy": ["decision"] },
        { "from": "draft", "to": "superseded", "triggeredBy": ["decision"] },
        { "from": "approved", "to": "archived", "triggeredBy": ["decision", "milestone"] },
        { "from": "approved", "to": "superseded", "triggeredBy": ["decision"] }
      ],
      "approverRoles": ["architect", "productOwner", "deliveryLead"],
      "notes": "An initiative stays approved while it is being delivered; the delivery work items move, not the initiative. Archival needs a user acceptance record."
    },
    "decision-record": {
      "type": "decision-record",
      "field": "lifecycle",
      "validStatuses": ["proposed", "review", "approved", "superseded"],
      "transitions": [
        { "from": "proposed", "to": "review", "triggeredBy": ["decision", "checkpoint"] },
        { "from": "review", "to": "approved", "triggeredBy": ["decision", "checkpoint"] },
        { "from": "approved", "to": "superseded", "triggeredBy": ["decision"] }
      ],
      "approverRoles": ["architect", "productOwner", "technicalLead"],
      "notes": "Approved decisions are never archived or deleted; a dead decision is superseded and names its successor.",
      "extensions": {
        "confluence": {
          "pageStatus": { "proposed": "Rough draft", "review": "Ready for review", "approved": "Verified" }
        }
      }
    },
    "design": {
      "type": "design",
      "field": "lifecycle",
      "validStatuses": ["draft", "review", "approved", "delivered", "superseded"],
      "transitions": [
        { "from": "draft", "to": "review", "triggeredBy": ["decision", "checkpoint"] },
        { "from": "review", "to": "approved", "triggeredBy": ["decision", "checkpoint"] },
        { "from": "approved", "to": "delivered", "triggeredBy": ["milestone", "checkpoint"] },
        { "from": "*", "to": "superseded", "triggeredBy": ["decision"] }
      ],
      "approverRoles": ["architect", "technicalLead"],
      "notes": "delivered means the implementation shipped. Any design can be superseded, from any status."
    }
  }
}
