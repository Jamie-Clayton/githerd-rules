{
  "$schema": "https://jamie-clayton.github.io/githerd-rules/lifecycle-policies/0.9/lifecycle-policies.schema.json",
  "identifier": "https://example.org/policies/minimal",
  "modified": "2026-10-05",
  "policies": {
    "document": {
      "type": "document",
      "field": "status",
      "validStatuses": [
        "draft",
        "published"
      ],
      "transitions": [
        {
          "from": "draft",
          "to": "published",
          "triggeredBy": [
            "decision"
          ]
        }
      ]
    }
  }
}
