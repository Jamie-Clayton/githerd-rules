{
  "@context": {
    "@version": 1.1,
    "dcterms": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sv": "https://jamie-clayton.github.io/githerd-rules/subject-vocabulary/0.9/terms#",
    "ability": "https://jamie-clayton.github.io/githerd-rules/subject-vocabulary/concepts/ability/",

    "$schema": { "@id": "dcterms:conformsTo", "@type": "@id" },
    "title": "dcterms:title",
    "description": "dcterms:description",
    "identifier": "dcterms:identifier",
    "creator": "dcterms:creator",
    "contributor": { "@id": "dcterms:contributor", "@container": "@set" },
    "publisher": "dcterms:publisher",
    "subject": { "@id": "dcterms:subject", "@container": "@set" },
    "created": "dcterms:created",
    "modified": "dcterms:modified",
    "version": "dcterms:hasVersion",
    "source": "dcterms:source",
    "language": "dcterms:language",
    "coverage": "dcterms:coverage",
    "rights": "dcterms:rights",
    "references": { "@id": "dcterms:references", "@container": "@set" },

    "core": "sv:coreMode",
    "prefixes": { "@id": "sv:prefix", "@container": "@set" },
    "conceptBase": { "@id": "sv:conceptBase", "@type": "@id" },
    "concepts": { "@id": "skos:hasTopConcept", "@container": "@set" },
    "notation": "skos:notation",
    "prefLabel": "skos:prefLabel",
    "altLabel": { "@id": "skos:altLabel", "@container": "@set" },
    "hiddenLabel": { "@id": "skos:hiddenLabel", "@container": "@set" },
    "definition": "skos:definition",
    "scopeNote": "skos:scopeNote",
    "audience": "dcterms:audience",
    "broader": { "@id": "skos:broader", "@type": "@id", "@container": "@set" },
    "narrower": { "@id": "skos:narrower", "@type": "@id", "@container": "@set" },
    "related": { "@id": "skos:related", "@type": "@id", "@container": "@set" },
    "exactMatch": { "@id": "skos:exactMatch", "@container": "@set" },
    "closeMatch": { "@id": "skos:closeMatch", "@container": "@set" },
    "scheme": "skos:inScheme",
    "informative": "sv:informative",

    "hints": { "@id": "sv:hints", "@container": "@index" },
    "components": { "@id": "sv:component", "@container": "@set" },
    "paths": { "@id": "sv:path", "@container": "@set" },
    "legacy": { "@id": "sv:legacy", "@type": "@json" },
    "retired": { "@id": "sv:retired", "@container": "@set" },
    "isReplacedBy": { "@id": "dcterms:isReplacedBy", "@type": "@id" },
    "deprecatedAt": "sv:deprecatedAt",
    "removedAt": "sv:removedAt",
    "rationale": "sv:rationale",
    "extensions": { "@id": "sv:extensions", "@type": "@json" }
  }
}
